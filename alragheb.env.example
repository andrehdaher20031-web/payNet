# Copy only the relevant settings into the existing backend environment.
# Never put the provider token in the frontend environment.
ALRAGHEB_CATALOG_ENABLED=true
ALRAGHEB_PURCHASE_ENABLED=false
# Round the final SYP total to two decimals, never the unit price.
ALRAGHEB_ROUNDING_POLICY=syp_2dp
# ALRAGHEB_API_TOKEN is already configured in the backend .env.
# The reconciliation worker runs independently of the purchase/catalog switches.
